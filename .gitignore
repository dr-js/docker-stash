# ignore folder of file with `-gitignore`
**/*-gitignore/**
**/*-gitignore*

# editor
/.vscode
/.idea

# nodejs, npm, npm tarballs
node_modules
.npmrc
/*.tgz

# Ignore config/cache json
source/*/TAG_CORE*.json
source/*/BUILD_REPO*.json

# create your own `~/.config/git/ignore` config if you need more, see https://docs.github.com/get-started/git-basics/ignoring-files
